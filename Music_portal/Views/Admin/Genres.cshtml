@model List<AdminGenreViewModel>
@{
    ViewData["Title"] = "Жанры";
}

<div class="admin-header">
    <h1 class="admin-title">Жанры</h1>
    <a asp-action="GenreCreate" class="admin-btn admin-btn-primary">+ Добавить жанр</a>
</div>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Описание</th>
                <th>Песен</th>
                <th class="admin-th-actions">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var genre in Model)
            {
                <tr>
                    <td>@genre.Id</td>
                    <td>@genre.Name</td>
                    <td>@(genre.Description ?? "—")</td>
                    <td>@genre.SongCount</td>
                    <td>
                        <a asp-action="GenreEdit" asp-route-id="@genre.Id" class="admin-btn admin-btn-sm admin-btn-primary">Редактировать</a>
                        <form asp-action="GenreDelete" asp-route-id="@genre.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Удалить жанр @genre.Name?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-btn admin-btn-sm admin-btn-reject">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="admin-btn admin-btn-secondary mt-3">← Назад</a>
