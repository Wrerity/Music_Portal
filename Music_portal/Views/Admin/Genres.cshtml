@model List<AdminGenreViewModel>
@inject IStringLocalizer<SharedResource> Loc
@{
    ViewData["Title"] = Loc["Admin_Genres_Title"];
}

<div class="admin-header">
    <h1 class="admin-title">@Loc["Admin_Genres_Title"]</h1>
    <a asp-action="GenreCreate" class="admin-btn admin-btn-primary">+ @Loc["Button_AddGenre"]</a>
</div>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>@Loc["Table_Name"]</th>
                <th>@Loc["Table_Description"]</th>
                <th>@Loc["Table_SongCount"]</th>
                <th class="admin-th-actions">@Loc["Table_Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var genre in Model)
            {
                <tr>
                    <td>@genre.Id</td>
                    <td>@genre.Name</td>
                    <td>@(genre.Description ?? "—")</td>
                    <td>@genre.SongCount</td>
                    <td>
                        <a asp-action="GenreEdit" asp-route-id="@genre.Id" class="admin-btn admin-btn-sm admin-btn-primary">@Loc["Button_Edit"]</a>
                        <form asp-action="GenreDelete" asp-route-id="@genre.Id" method="post" class="d-inline"
                              onsubmit="return confirm('@Loc["Confirm_DeleteGenre", genre.Name]');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-btn admin-btn-sm admin-btn-reject">@Loc["Button_Delete"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="admin-btn admin-btn-secondary mt-3">← @Loc["Button_Back"]</a>