@model Music_portal.ViewModels.Admin.DashboardStats
@inject IStringLocalizer<SharedResource> Loc
@{
    ViewData["Title"] = Loc["Admin_Title"];
}

<div class="admin-page-layout">
    <div class="admin-header">
        <h1 class="admin-title">@Loc["Admin_Header"]</h1>
        <p class="admin-subtitle">@Loc["Admin_Subtitle"]</p>
    </div>

    <div class="admin-dashboard">
        <a asp-action="Users" class="admin-card">
            <div class="admin-card-icon">
                <img src="~/icons/People.svg" alt="Users" width="32" height="32" />
            </div>
            <div class="admin-card-body">
                <div class="admin-card-number">@Model.TotalUsers</div>
                <div class="admin-card-label">@Loc["Admin_Users"]</div>
            </div>
        </a>
        <a asp-action="PendingRequests" class="admin-card">
            <div class="admin-card-icon">
                <img src="~/icons/request.svg" alt="Requests" width="32" height="32" />
            </div>
            <div class="admin-card-body">
                <div class="admin-card-number">@Model.PendingCount</div>
                <div class="admin-card-label">@Loc["Admin_Requests"]</div>
            </div>
        </a>
        <a asp-action="Songs" class="admin-card">
            <div class="admin-card-icon">
                <img src="~/icons/Play.svg" alt="Songs" width="32" height="32" />
            </div>
            <div class="admin-card-body">
                <div class="admin-card-number">@Model.TotalSongs</div>
                <div class="admin-card-label">@Loc["Admin_Songs"]</div>
            </div>
        </a>
        <a asp-action="Genres" class="admin-card">
            <div class="admin-card-icon">
                <img src="~/icons/tags.svg" alt="Genres" width="32" height="32" />
            </div>
            <div class="admin-card-body">
                <div class="admin-card-number">@Model.TotalGenres</div>
                <div class="admin-card-label">@Loc["Admin_Genres"]</div>
            </div>
        </a>
        <a asp-action="Authors" class="admin-card">
            <div class="admin-card-icon">
                <img src="~/icons/People.svg" alt="Authors" width="32" height="32" />
            </div>
            <div class="admin-card-body">
                <div class="admin-card-number">@Model.TotalAuthors</div>
                <div class="admin-card-label">@Loc["Admin_Authors"]</div>
            </div>
        </a>
    </div>

    <div class="text-center mt-3">
        <a asp-action="Spa" class="admin-btn admin-btn-primary">🚀 Admin SPA (AJAX + Web API) — Single Page</a>
        <p class="text-muted mt-2" style="font-size:0.85em">REST: GET POST PUT DELETE через <code>fetch</code> к <code>/api/*</code> — без ViewModel</p>
    </div>

    <div class="admin-nav-list mt-4">
        <a asp-action="Users" class="admin-nav-item">
            <span><img src="~/icons/People.svg" alt="" width="20" height="20" style="vertical-align:middle;margin-right:8px;" /> @Loc["Admin_Users"]</span>
            <small>@Loc["Admin_ManageUsers"]</small>
        </a>
        <a asp-action="PendingRequests" class="admin-nav-item">
            <span><img src="~/icons/request.svg" alt="" width="20" height="20" style="vertical-align:middle;margin-right:8px;" /> @Loc["Admin_Requests_Title"]</span>
            <small>@Model.PendingCount @Loc["Admin_PendingCount"]</small>
        </a>
        <a asp-action="Genres" class="admin-nav-item">
            <span><img src="~/icons/tags.svg" alt="" width="20" height="20" style="vertical-align:middle;margin-right:8px;" /> @Loc["Admin_Genres"]</span>
            <small>@Loc["Admin_ManageGenres"]</small>
        </a>
        <a asp-action="Authors" class="admin-nav-item">
            <span><img src="~/icons/People.svg" alt="" width="20" height="20" style="vertical-align:middle;margin-right:8px;" /> @Loc["Admin_Authors"]</span>
            <small>@Loc["Admin_ManageAuthors"]</small>
        </a>
        <a asp-action="Songs" class="admin-nav-item">
            <span><img src="~/icons/Play.svg" alt="" width="20" height="20" style="vertical-align:middle;margin-right:8px;" /> @Loc["Admin_Songs"]</span>
            <small>@Loc["Admin_AllSongs"]</small>
        </a>
    </div>
</div>