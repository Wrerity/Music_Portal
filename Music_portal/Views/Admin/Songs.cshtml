@model AdminSongListViewModel
@inject IStringLocalizer<SharedResource> Loc
@{
    ViewData["Title"] = Loc["Admin_AllSongs_Title"];
}

<div class="admin-header">
    <h1 class="admin-title">@Loc["Admin_AllSongs_Title"]</h1>
</div>

<form method="get" asp-action="Songs" class="admin-search-form">
    <input type="text" name="search" class="admin-input" value="@Model.Search" placeholder="@Loc["Placeholder_SearchTitle"]" />
    <button type="submit" class="admin-btn admin-btn-primary">@Loc["Button_Search"]</button>
    <a asp-action="Songs" class="admin-btn admin-btn-secondary">@Loc["Filter_Reset"]</a>
</form>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>@Loc["Table_Title"]</th>
                <th>@Loc["Table_Authors"]</th>
                <th>@Loc["Table_Genres"]</th>
                <th>@Loc["Table_UploadedBy"]</th>
                <th>@Loc["Table_Date"]</th>
                <th>@Loc["Table_PlaysShort"]</th>
                <th class="admin-th-actions">@Loc["Table_Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var song in Model.Songs)
            {
                <tr>
                    <td>@song.Id</td>
                    <td>@song.Title</td>
                    <td>@song.Authors</td>
                    <td>@song.Genres</td>
                    <td>@song.UploadedBy</td>
                    <td>@song.UploadDate.ToString("dd.MM.yyyy")</td>
                    <td>@song.PlayCount</td>
                    <td>
                        <a asp-action="SongEdit" asp-route-id="@song.Id" class="admin-btn admin-btn-sm admin-btn-primary">@Loc["Button_Edit"]</a>
                        <form asp-action="SongDelete" asp-route-id="@song.Id" method="post" class="d-inline"
                              onsubmit="return confirm('@Loc["Confirm_DeleteSongAdmin", song.Title]');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-btn admin-btn-sm admin-btn-reject">@Loc["Button_Delete"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="admin-pagination">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a class="admin-page @(p == Model.Page ? "active" : "")"
               href="@Url.Action("Songs", new { search = Model.Search, page = p })">@p</a>
        }
    </nav>
}

<a asp-action="Index" class="admin-btn admin-btn-secondary mt-3">← @Loc["Button_Back"]</a>