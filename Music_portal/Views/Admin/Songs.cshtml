@model AdminSongListViewModel
@{
    ViewData["Title"] = "Все песни";
}

<div class="admin-header">
    <h1 class="admin-title">Все песни</h1>
</div>

<form method="get" asp-action="Songs" class="admin-search-form">
    <input type="text" name="search" class="admin-input" value="@Model.Search" placeholder="Поиск по названию..." />
    <button type="submit" class="admin-btn admin-btn-primary">Поиск</button>
    <a asp-action="Songs" class="admin-btn admin-btn-secondary">Сброс</a>
</form>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Авторы</th>
                <th>Жанры</th>
                <th>Загрузил</th>
                <th>Дата</th>
                <th>Прослушиваний</th>
                <th class="admin-th-actions">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var song in Model.Songs)
            {
                <tr>
                    <td>@song.Id</td>
                    <td>@song.Title</td>
                    <td>@song.Authors</td>
                    <td>@song.Genres</td>
                    <td>@song.UploadedBy</td>
                    <td>@song.UploadDate.ToString("dd.MM.yyyy")</td>
                    <td>@song.PlayCount</td>
                    <td>
                        <a asp-action="SongEdit" asp-route-id="@song.Id" class="admin-btn admin-btn-sm admin-btn-primary">Редактировать</a>
                        <form asp-action="SongDelete" asp-route-id="@song.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Удалить песню @song.Title? Файл будет удалён с сервера.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-btn admin-btn-sm admin-btn-reject">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="admin-pagination">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a class="admin-page @(p == Model.Page ? "active" : "")"
               href="@Url.Action("Songs", new { search = Model.Search, page = p })">@p</a>
        }
    </nav>
}

<a asp-action="Index" class="admin-btn admin-btn-secondary mt-3">← Назад</a>
