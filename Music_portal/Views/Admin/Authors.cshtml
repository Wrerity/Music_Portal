@model List<AdminAuthorViewModel>
@{
    ViewData["Title"] = "Авторы";
}

<div class="admin-header">
    <h1 class="admin-title">Авторы</h1>
    <a asp-action="AuthorCreate" class="admin-btn admin-btn-primary">+ Добавить автора</a>
</div>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Имя</th>
                <th>Страна</th>
                <th>Описание</th>
                <th>Песен</th>
                <th class="admin-th-actions">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var author in Model)
            {
                <tr>
                    <td>@author.Id</td>
                    <td>@author.Name</td>
                    <td>@(author.Country ?? "—")</td>
                    <td>@(author.Description ?? "—")</td>
                    <td>@author.SongCount</td>
                    <td>
                        <a asp-action="AuthorEdit" asp-route-id="@author.Id" class="admin-btn admin-btn-sm admin-btn-primary">Редактировать</a>
                        <form asp-action="AuthorDelete" asp-route-id="@author.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Удалить автора @author.Name?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-btn admin-btn-sm admin-btn-reject">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="admin-btn admin-btn-secondary mt-3">← Назад</a>
