@model AdminAuthorViewModel
@inject IStringLocalizer<SharedResource> Loc
@{
    ViewData["Title"] = Loc["Admin_EditAuthor_Title"];
}

<div class="admin-header">
    <h1 class="admin-title">@Loc["Admin_EditAuthor_Title"]</h1>
</div>

<form asp-action="AuthorEdit" method="post" class="admin-form">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="admin-validation"></div>

    <div class="admin-form-group">
        <label asp-for="Name" class="admin-label"></label>
        <input asp-for="Name" class="admin-input" />
        <span asp-validation-for="Name" class="admin-field-error"></span>
    </div>

    <div class="admin-form-group">
        <label asp-for="Country" class="admin-label">@Loc["Field_Country"]</label>
        <input asp-for="Country" class="admin-input" />
        <span asp-validation-for="Country" class="admin-field-error"></span>
    </div>

    <div class="admin-form-group">
        <label asp-for="Description" class="admin-label">@Loc["Field_Description"]</label>
        <textarea asp-for="Description" class="admin-input" rows="3"></textarea>
        <span asp-validation-for="Description" class="admin-field-error"></span>
    </div>

    <div class="admin-form-actions">
        <button type="submit" class="admin-btn admin-btn-primary">@Loc["Button_Save"]</button>
        <a asp-action="Authors" class="admin-btn admin-btn-secondary">@Loc["Button_Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}