@model List<UserDto>
@{
    ViewData["Title"] = "Заявки на регистрацию";
}

<div class="admin-header">
    <h1 class="admin-title">Заявки на регистрацию</h1>
</div>

@if (Model.Count == 0)
{
    <div class="admin-empty">Нет новых заявок на регистрацию.</div>
}
else
{
    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Имя пользователя</th>
                    <th>Дата регистрации</th>
                    <th class="admin-th-actions">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td>@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <form asp-action="Approve" asp-route-id="@user.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-btn admin-btn-approve">Принять</button>
                            </form>
                            <form asp-action="Reject" asp-route-id="@user.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-btn admin-btn-reject">Отклонить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" class="admin-btn admin-btn-secondary mt-3">← Назад</a>
