@model List<UserDto>
@inject IStringLocalizer<SharedResource> Loc
@{
    ViewData["Title"] = Loc["Admin_Requests_Title"];
}

<div class="admin-header">
    <h1 class="admin-title">@Loc["Admin_Requests_Title"]</h1>
</div>

@if (Model.Count == 0)
{
    <div class="admin-empty">@Loc["Admin_EmptyRequests"]</div>
}
else
{
    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@Loc["Table_Username"]</th>
                    <th>@Loc["Table_CreatedAt"]</th>
                    <th class="admin-th-actions">@Loc["Table_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td>@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <form asp-action="Approve" asp-route-id="@user.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-btn admin-btn-approve">@Loc["Button_Approve"]</button>
                            </form>
                            <form asp-action="Reject" asp-route-id="@user.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-btn admin-btn-reject">@Loc["Button_Reject"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" class="admin-btn admin-btn-secondary mt-3">← @Loc["Button_Back"]</a>