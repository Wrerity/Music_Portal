@model AdminUserCreateViewModel
@inject IStringLocalizer<SharedResource> Loc
@{
    ViewData["Title"] = Loc["Admin_CreateUser_Title"];
}

<div class="admin-header">
    <h1 class="admin-title">@Loc["Admin_CreateUser_Title"]</h1>
</div>

<form asp-action="UserCreate" method="post" class="admin-form">
    <div asp-validation-summary="ModelOnly" class="admin-validation"></div>

    <div class="admin-form-group">
        <label asp-for="Username" class="admin-label"></label>
        <input asp-for="Username" class="admin-input" />
        <span asp-validation-for="Username" class="admin-field-error"></span>
    </div>

    <div class="admin-form-group">
        <label asp-for="Password" class="admin-label"></label>
        <input asp-for="Password" class="admin-input" type="password" />
        <span asp-validation-for="Password" class="admin-field-error"></span>
    </div>

    <div class="admin-form-group">
        <label asp-for="Role" class="admin-label"></label>
        <select asp-for="Role" class="admin-input">
            <option value="User">@Loc["Role_User"]</option>
            <option value="Admin">@Loc["Role_Admin"]</option>
        </select>
        <span asp-validation-for="Role" class="admin-field-error"></span>
    </div>

    <div class="admin-form-group admin-form-check">
        <input asp-for="IsApproved" class="admin-checkbox" />
        <label asp-for="IsApproved">@Loc["Field_IsApproved"]</label>
    </div>

    <div class="admin-form-actions">
        <button type="submit" class="admin-btn admin-btn-primary">@Loc["Button_Create"]</button>
        <a asp-action="Users" class="admin-btn admin-btn-secondary">@Loc["Button_Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}