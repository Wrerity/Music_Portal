@inject IStringLocalizer<SharedResource> Loc
@{
    ViewData["Title"] = Loc["NotFound_Title"];
}

<div class="text-center mt-5">
    <h1 class="display-1 text-accent">404</h1>
    <h2 class="text-dark-custom">@Loc["NotFound_Header"]</h2>
    <p class="text-muted">@Loc["NotFound_Text"]</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-accent btn-no-hover mt-3">@Loc["Button_ToHome"]</a>
</div>