@using Music_portal.Utils
@model CatalogViewModel
@inject IStringLocalizer<SharedResource> Loc
@{
    ViewData["Title"] = Loc["Home_Title"];
}

<div class="text-center mb-4">
    <h1 class="display-4 text-accent">@Loc["Home_Welcome"]</h1>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-4 align-items-end">
    <div class="col-md-3">
        <label class="form-label text-dark-custom">@Loc["Filter_Search"]</label>
        <input type="text" name="search" class="form-control" value="@Model.SearchTerm" placeholder="@Loc["Filter_SearchPlaceholder"]" />
    </div>
    <div class="col-md-2">
        <label class="form-label text-dark-custom">@Loc["Filter_Genres"]</label>
        <select name="genreIds" class="form-select">
            <option value="">@Loc["Filter_AllGenres"]</option>
            @foreach (var g in Model.AllGenres)
            {
                <option value="@g.Id" selected="@Model.SelectedGenreIds.Contains(g.Id)">@g.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label text-dark-custom">@Loc["Filter_Authors"]</label>
        <select name="authorIds" class="form-select">
            <option value="">@Loc["Filter_AllAuthors"]</option>
            @foreach (var a in Model.AllAuthors)
            {
                <option value="@a.Id" selected="@Model.SelectedAuthorIds.Contains(a.Id)">@a.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label text-dark-custom">@Loc["Filter_Sort"]</label>
        <select name="sortBy" class="form-select">
            <option value="date" selected="@(Model.SortBy=="date")">@Loc["Sort_New"]</option>
            <option value="popularity" selected="@(Model.SortBy=="popularity")">@Loc["Sort_Popular"]</option>
            <option value="title" selected="@(Model.SortBy=="title")">@Loc["Sort_Title"]</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-1 align-items-end">
        <button type="submit" class="btn btn-accent flex-fill">@Loc["Filter_Apply"]</button>
        <a asp-action="Index" class="btn btn-outline-dark-custom flex-fill">@Loc["Filter_Reset"]</a>
    </div>
</form>

<div class="song-grid">
    @foreach (var song in Model.Songs)
    {
        <div class="song-card">
            <div class="song-image">
                <img src="~/icons/Play.svg" alt="Play" width="48" height="48" style="opacity:0.7;filter:brightness(0) invert(1);" />
            </div>
            <button class="btn-play" title="@Loc["Song_ListenTitle"]" data-song-id="@song.Id">
                <img src="~/icons/Play.svg" class="play-icon" alt="Play" width="14" height="14" style="filter:brightness(0) invert(1);vertical-align:middle;" />
            </button>
            <div class="song-title"><a asp-controller="Song" asp-action="Details" asp-route-id="@song.Id">@song.Title</a></div>
            <div class="song-listeners">@song.PlayCount @Loc["Song_Listeners"]</div>
            <div class="song-genres">@ViewHelper.TruncateGenres(song.Genres)</div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="song-download">
                    <a asp-controller="Song" asp-action="Download" asp-route-id="@song.Id" class="btn btn-dark-custom btn-sm w-100 rounded-0">
                        <img src="~/icons/download.svg" alt="Download" width="12" height="12" style="filter:brightness(0) invert(1);vertical-align:middle;margin-right:4px;" /> @Loc["Song_Download"]
                    </a>
                </div>
            }
            else
            {
                <div class="song-download">
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-dark-custom btn-sm w-100 rounded-0">@Loc["Song_LoginToDownload"]</a>
                </div>
            }
            <div class="player-bar" style="display:none;">
                <input type="range" class="player-volume" min="1" max="100" value="50" />
            </div>
        </div>
    }
</div>

<div class="d-flex gap-2 mb-3 align-items-center">
    <span class="text-muted">@Loc["Filter_Sort"]:</span>
    <sort-link sort-by="date" current-sort-by="@Model.SortBy" search="@Model.SearchTerm" genre-ids="@Model.SelectedGenreIds" author-ids="@Model.SelectedAuthorIds" class="btn btn-sm @(Model.SortBy=="date" ? "btn-accent" : "btn-outline-dark-custom")">@Loc["Sort_New"]</sort-link>
    <sort-link sort-by="popularity" current-sort-by="@Model.SortBy" search="@Model.SearchTerm" genre-ids="@Model.SelectedGenreIds" author-ids="@Model.SelectedAuthorIds" class="btn btn-sm @(Model.SortBy=="popularity" ? "btn-accent" : "btn-outline-dark-custom")">@Loc["Sort_Popular"]</sort-link>
    <sort-link sort-by="title" current-sort-by="@Model.SortBy" search="@Model.SearchTerm" genre-ids="@Model.SelectedGenreIds" author-ids="@Model.SelectedAuthorIds" class="btn btn-sm @(Model.SortBy=="title" ? "btn-accent" : "btn-outline-dark-custom")">@Loc["Sort_Title"]</sort-link>
    <span class="text-muted ms-auto">@Model.TotalCount @Loc["Song_Listeners"] — @Loc["Table_Plays"] @Model.Page/@Model.TotalPages</span>
</div>

<pagination total-pages="@Model.TotalPages" current-page="@Model.Page" search="@Model.SearchTerm" sort-by="@Model.SortBy" genre-ids="@Model.SelectedGenreIds" author-ids="@Model.SelectedAuthorIds"></pagination>

@section Scripts {
    <script>
        var currentAudio = null;
        var currentBtn = null;
        var currentCard = null;

        document.querySelectorAll('.btn-play').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var card = this.closest('.song-card');
                var bar = card.querySelector('.player-bar');
                var volumeInput = bar.querySelector('.player-volume');
                var songId = this.getAttribute('data-song-id');
                var icon = this.querySelector('.play-icon');

                if (currentAudio && currentAudio.dataset.songId === songId && !currentAudio.paused) {
                    currentAudio.pause();
                    icon.src = '/icons/Play.svg';
                    bar.style.display = 'none';
                    return;
                }

                if (currentAudio) {
                    currentAudio.pause();
                    if (currentBtn) {
                        currentBtn.querySelector('.play-icon').src = '/icons/Play.svg';
                    }
                    if (currentCard) {
                        currentCard.querySelector('.player-bar').style.display = 'none';
                    }
                }

                currentAudio = new Audio('/Song/Stream/' + songId);
                currentAudio.dataset.songId = songId;
                currentAudio.volume = volumeInput.value / 100;
                currentBtn = this;
                currentCard = card;
                icon.src = '/icons/Stop.svg';
                bar.style.display = 'flex';
                currentAudio.play();

                volumeInput.oninput = function () {
                    currentAudio.volume = this.value / 100;
                };

                currentAudio.addEventListener('ended', function () {
                    icon.src = '/icons/Play.svg';
                    bar.style.display = 'none';
                    currentAudio = null;
                    currentBtn = null;
                    currentCard = null;
                });
            });
        });
    </script>
}

