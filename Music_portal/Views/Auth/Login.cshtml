@model LoginViewModel
@inject IStringLocalizer<SharedResource> Loc
@{
    ViewData["Title"] = Loc["Login_Title"];
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="text-accent">@Loc["Login_Header"]</h2>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label text-dark-custom">@Loc["Field_Username"]</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label text-dark-custom">@Loc["Field_Password"]</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-accent">@Loc["Login_Button"]</button>
        </form>
        <p class="mt-3">
            @Loc["Login_NoAccount"] <a asp-action="Register">@Loc["Login_RegisterLink"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}