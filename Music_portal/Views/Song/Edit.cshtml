@model SongEditViewModel
@inject IStringLocalizer<SharedResource> Loc
@{
    ViewData["Title"] = Loc["Song_Edit_Title"];
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="text-accent">@Loc["Song_Edit_Header"]</h2>
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label text-dark-custom">@Loc["Field_Title"]</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AuthorIds" class="form-label text-dark-custom">@Loc["Field_Authors"]</label>
                <select asp-for="AuthorIds" asp-items="@(new MultiSelectList(Model.AllAuthors, "Id", "Name"))" class="form-select" multiple size="5"></select>
                <span asp-validation-for="AuthorIds" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewAuthorName" class="form-label text-dark-custom">@Loc["Field_NewAuthor"]</label>
                <input asp-for="NewAuthorName" class="form-control" placeholder="@Loc["Field_NewAuthorPlaceholder"]" />
            </div>

            <div class="mb-3">
                <label asp-for="GenreIds" class="form-label text-dark-custom">@Loc["Field_Genres"]</label>
                <select asp-for="GenreIds" asp-items="@(new MultiSelectList(Model.AllGenres, "Id", "Name"))" class="form-select" multiple size="5"></select>
                <span asp-validation-for="GenreIds" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Duration" class="form-label text-dark-custom">@Loc["Field_Duration"]</label>
                <input asp-for="Duration" class="form-control" type="number" min="0" />
            </div>

            <div class="mb-3">
                <label asp-for="Lyrics" class="form-label text-dark-custom">@Loc["Field_Lyrics"]</label>
                <textarea asp-for="Lyrics" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Lyrics" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AudioFile" class="form-label text-dark-custom">@Loc["Field_ReplaceAudio"]</label>
                <input asp-for="AudioFile" class="form-control" type="file" accept=".mp3,.wav" />
            </div>

            <button type="submit" class="btn btn-accent">@Loc["Button_Save"]</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark-custom ms-2">@Loc["Button_Cancel"]</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}