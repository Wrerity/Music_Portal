@model List<SongDisplayViewModel>
@inject IStringLocalizer<SharedResource> Loc
@{
    ViewData["Title"] = Loc["Song_MySongs_Title"];
}

<h2 class="text-accent">@Loc["Song_MySongs_Header"]</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Count == 0)
{
    <p class="text-dark-custom">@Loc["Song_MySongs_NoSongs"]</p>
    <a asp-action="Create" class="btn btn-accent">@Loc["Button_AddSong"]</a>
}
else
{
    <div class="admin-table-wrapper mt-3">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@Loc["Table_Title"]</th>
                    <th>@Loc["Table_Authors"]</th>
                    <th>@Loc["Table_Genres"]</th>
                    <th>@Loc["Table_Plays"]</th>
                    <th class="admin-th-actions">@Loc["Table_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var song in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@song.Id">@song.Title</a></td>
                        <td>@song.Authors</td>
                        <td>@song.Genres</td>
                        <td>@song.PlayCount</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@song.Id" class="admin-btn admin-btn-sm admin-btn-primary">@Loc["Button_Edit"]</a>
                            <form asp-action="Delete" asp-route-id="@song.Id" method="post" class="d-inline" onsubmit="return confirm('@Loc["Confirm_DeleteSong"]');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-btn admin-btn-sm admin-btn-reject">@Loc["Button_Delete"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" asp-controller="Home" class="btn btn-outline-dark-custom mt-2">@Loc["Button_ToHome"]</a>